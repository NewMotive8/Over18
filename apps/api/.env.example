# Over18 API — environment variables
# Copy to .env and adjust. Never commit real .env files or real credentials.

# PostgreSQL connection string (REQUIRED — the API refuses to start without it).
# On Railway this is injected automatically by the PostgreSQL service.
# Locally, point it at your own dev database. Example format only — not a real credential:
DATABASE_URL=postgresql://user:password@localhost:5432/over18_dev

# Port the API listens on
PORT=3001

# Host binding (0.0.0.0 for containers, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Allowed CORS origin (the web app's URL). Never "*" — credentials are enabled.
CORS_ORIGIN=http://localhost:5173

# Session cookie settings
# COOKIE_SECURE defaults to true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=true
# SameSite for the session cookie: lax (default) | strict | none.
# Use "none" (with COOKIE_SECURE=true) only if web and API are served from different sites.
# COOKIE_SAMESITE=lax

# Session lifetime in days (default 30)
# SESSION_TTL_DAYS=30

# ── LLM inference (US-08) ────────────────────────────────────────────────
# When LLM_BASE_URL is unset: development uses the deterministic fallback
# reply provider; production (NODE_ENV=production) REFUSES to fake AI and
# answers message sends with 503 ai_not_configured. When set, character
# replies come from the configured OpenAI-compatible inference endpoint
# (vLLM, TGI, llama.cpp, Ollama, hosted routers, ...). No vendor/model is
# hardcoded in code — everything below is configuration.
# Example values only — never commit real endpoints or keys.
# LLM_BASE_URL=https://your-inference-host/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=            # optional; omit for keyless self-hosted endpoints
# LLM_PROVIDER=openai-compatible
# LLM_TIMEOUT_MS=30000
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.8

# ── Real LLM provider (US-33): OpenRouter ────────────────────────────────
# OpenRouter speaks the same OpenAI-compatible /chat/completions protocol
# the US-08 adapter already uses, so the real provider is enabled by
# configuration alone — no code changes, no second provider abstraction.
#
# WHERE TO SET THESE: on the API service only (Railway → API service →
# Variables), or a local apps/api/.env. The key is server-side by design:
# it is read once from the environment (src/env.ts), used only in the
# Authorization header of server→provider requests, and is never logged,
# never included in error messages, and never part of any API response.
# The browser talks exclusively to our API — it never sees the provider,
# the key, or the composed prompts.
#
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=nousresearch/hermes-3-llama-3.1-70b
# LLM_API_KEY=            # sk-or-... — real key ONLY in Railway/.env, never committed
#
# Model choice: hermes-3-llama-3.1-70b had the best latency and tied-best
# memory recall with no adult-probe refusals in the US-33 candidate eval
# (see llm-eval transcripts from the discovery run). Alternatives that also
# ran clean: meta-llama/llama-3.3-70b-instruct, mistralai/mistral-nemo,
# sao10k/l3-lunaris-8b. Final model selection is configuration — swap
# LLM_MODEL when the team signs off, nothing else changes.
#
# Timeout / token / sampling settings stay environment-driven via the
# US-08 knobs above (LLM_TIMEOUT_MS, LLM_MAX_TOKENS, LLM_TEMPERATURE) and
# the US-10/US-12 context knobs below. Failure and timeout behaviour is
# unchanged: provider errors surface as the existing clean 502 with full
# exchange rollback; an unconfigured production answers 503 ai_not_configured.
#
# SMOKE TEST (documented US-33 acceptance): scripts/llm-smoke.mjs sends one
# real request over the exact production wire shape and prints latency plus
# an excerpt of the reply. Run it from a machine with internet access:
#
#   cd apps/api
#   LLM_BASE_URL=https://openrouter.ai/api/v1 \
#   LLM_MODEL=nousresearch/hermes-3-llama-3.1-70b \
#   LLM_API_KEY=sk-or-... \
#   node scripts/llm-smoke.mjs
#
# Exit code 0 = the real provider completed a request through the same
# protocol/headers the backend uses; non-zero = fix configuration before
# setting the variables in Railway. After setting them in Railway, verify
# end-to-end by sending a chat message in the deployed app and confirming
# a non-deterministic in-character reply (and that /api responses contain
# no prompt or key material).
# Context window (US-10): bounds the conversation HISTORY sent to the model.
# The character instructions and the newest user message are always included.
# LLM_CONTEXT_MAX_MESSAGES=40
# LLM_CONTEXT_MAX_CHARS=16000

# ── Basic user memory (US-12) ────────────────────────────────────────────
# Durable user facts extracted from conversations, scoped strictly to
# (user, character), stored in PostgreSQL and injected into prompts.
# Extraction follows the LLM configuration above: real LLM when configured,
# deterministic rules in development, nothing in unconfigured production.
# MEMORY_MAX_INJECTED=10          # max facts injected into a single prompt
# MEMORY_MAX_INJECTED_CHARS=2000  # max total chars of injected facts
# MEMORY_MAX_STORED=100           # per (user, character) cap; oldest evicted
