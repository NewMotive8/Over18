# Over18 API — environment variables
# Copy to .env and adjust. Never commit real .env files.

# Port the API listens on
PORT=3001

# Host binding (0.0.0.0 for containers, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Allowed CORS origin (the web app's URL)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Railway) — not used yet, wired up in a later story
# DATABASE_URL=postgresql://user:password@host:port/database
