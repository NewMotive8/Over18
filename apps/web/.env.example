# Over18 web — environment variables
# Copy to .env and adjust. Only variables prefixed with VITE_ are exposed to the browser.

# Base URL of the Over18 REST API.
# NOTE: Vite bakes this in at BUILD time. On Railway, set it as a service
# variable on the web service BEFORE the build runs, e.g.:
#   VITE_API_URL=https://over18-production.up.railway.app
VITE_API_URL=http://localhost:3001
